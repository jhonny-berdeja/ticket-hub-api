# Ticket Hub API — environment variables reference.
#
# This file is documentation only: the app runs cluster-only and never
# reads a .env file (ConfigModule.forRoot({ ignoreEnvFile: true }) in
# src/common/config/env.module.ts). Every variable below must instead be
# injected as a real container env var via the Deployment/Secret — see the
# "Environment variables" table in README.md for where each one comes from.
# All 7 are mandatory; validation lives in src/common/config/env.validation.ts.

# Postgres role used to connect to ticket-hub-db.
POSTGRES_USER=ticket_hub_user

# Password for POSTGRES_USER.
POSTGRES_PASSWORD=change-me

# Postgres Service DNS name (cluster) or host (local Postgres).
DATABASE_HOST=ticket-hub-db.ticket-hub.svc.cluster.local

# Postgres port.
DATABASE_PORT=5432

# Database name.
DATABASE_NAME=ticket-hub-db

# Secret used to sign/verify login JWTs (1h expiry).
JWT_SECRET=change-me

# HTTP port the Nest app listens on.
PORT=3000
